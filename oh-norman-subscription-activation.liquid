<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office" lang="en">
<head>
  <!-- NAME: Subscription confirmation -->
  <!--[if gte mso 15]>
  <xml>
    <o:OfficeDocumentSettings>
      <o:AllowPNG/>
      <o:PixelsPerInch>96</o:PixelsPerInch>
    </o:OfficeDocumentSettings>
  </xml>
  <![endif]-->
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>You Started A New Subscription!</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&display=swap">
  <style type="text/css">
    @import url('https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&display=swap');
    @font-face {
      font-family: "SharpGroteskBold";
      src: url("https://cdn.shopify.com/s/files/1/0790/2049/1041/files/SharpGroteskBold-25.woff") format("woff");
      font-weight: 700;
      font-style: normal;
      mso-font-alt: "Arial Black";
    }
    @font-face {
      font-family: "SharpGroteskMedium";
      src: url("https://cdn.shopify.com/s/files/1/0790/2049/1041/files/SharpGroteskMedium-22.woff") format("woff");
      font-weight: 500;
      font-style: normal;
      mso-font-alt: "Arial";
    }
    @font-face {
      font-family: "SharpSans-Book";
      src: url("https://cdn.shopify.com/s/files/1/0790/2049/1041/files/SharpSans-Book.woff") format("woff");
      font-weight: 400;
      font-style: normal;
      mso-font-alt: "Arial";
    }
    body, table, td, p, a, li, blockquote { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; height: auto; }
    table { border-collapse: collapse; }
    body { margin: 0; padding: 0; width: 100%; background-color: #F3EDE1; font-family: "SharpSans-Book", "Open Sans", Arial, sans-serif !important; line-height: 1.4 !important; text-align: left !important; }
    a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; font-size: inherit !important; font-family: inherit !important; font-weight: inherit !important; line-height: inherit !important; }
    .rc_preview-text { display: none !important; max-height: 0; overflow: hidden; }
    .on-heading { font-family: "SharpGroteskBold", "Open Sans", Arial, sans-serif !important; font-weight: 700 !important; color: #960000 !important; text-align: left !important; margin: 0 0 20px; font-size: 32px; line-height: 1.4 !important; padding: 0; }
    .on-body { font-family: "SharpSans-Book", "Open Sans", Arial, sans-serif !important; color: #960000 !important; text-align: left !important; line-height: 1.4 !important; font-size: 15px; margin: 0 0 28px; padding: 0; }
    .on-section-headline { font-family: "SharpGroteskBold", "Open Sans", Arial, sans-serif !important; font-weight: 700 !important; color: #960000 !important; text-align: left !important; line-height: 1.4 !important; font-size: 25px; margin: 0 0 16px; padding: 0; }
    .on-cadence { font-family: "SharpGroteskMedium", "Open Sans", Arial, sans-serif !important; font-weight: 500 !important; color: #960000 !important; text-align: left !important; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; line-height: 1.4 !important; margin: 0 0 16px; padding: 0; }
    .on-step { font-family: "SharpSans-Book", "Open Sans", Arial, sans-serif !important; color: #960000 !important; text-align: left !important; line-height: 1.4 !important; font-size: 15px; }
    .on-nav a,
    .on-nav a:link,
    .on-nav a:visited,
    .on-nav-link,
    .on-nav-link span { font-family: "SharpGroteskMedium", "Open Sans", Arial, sans-serif !important; font-weight: 500 !important; color: #F3EDE1 !important; text-decoration: none !important; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; line-height: 1.4 !important; }
    .on-footer-text { font-family: "SharpSans-Book", "Open Sans", Arial, sans-serif !important; color: #F3EDE1 !important; font-size: 12px; line-height: 1.4 !important; text-align: center !important; margin: 0; }
    .manage_subscription_link { font-family: "SharpSans-Book", "Open Sans", Arial, sans-serif !important; color: #ffffff !important; text-decoration: none !important; }
    @media only screen and (max-width: 600px) {
      .on-content-pad { padding-left: 20px !important; padding-right: 20px !important; }
      .on-mascot-cell img { width: 180px !important; max-width: 180px !important; margin: 0 0 -48px 0 !important; }
    }
  </style>
  <!--[if mso]>
  <style type="text/css">
    body, table, td, p { font-family: Arial, sans-serif !important; }
    h1, h2, h3, h4, .on-heading, .on-section-headline, .on-cadence, .on-nav-link, .on-nav-link span { font-family: Arial Black, Arial, sans-serif !important; }
  </style>
  <![endif]-->
</head>
<body style="margin:0;padding:0;background-color:#F3EDE1;font-family:'SharpSans-Book', 'Open Sans', Arial, sans-serif !important;line-height:1.4 !important;text-align:left !important;">
  <!--[if !gte mso 9]><!--><span class="rc_preview-text" style="display:none;font-size:0;line-height:0;max-height:0;max-width:0;opacity:0;overflow:hidden;visibility:hidden;mso-hide:all;">You started a new subscription. Here’s what’s next.</span><!--<![endif]-->
  <center>
    <table align="center" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color:#F3EDE1;">
      <tr>
        <td align="center" valign="top">
          <!--[if (gte mso 9)|(IE)]>
          <table align="center" border="0" cellspacing="0" cellpadding="0" width="600" style="width:600px;">
          <tr>
          <td align="center" valign="top" width="600" style="width:600px;">
          <![endif]-->
          <table align="center" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width:600px;">

            <!-- Header -->
            <tr>
              <td align="left" style="background-color:#960000 !important;padding:28px 40px;text-align:left !important;">
                <a href="https://ohnorman.com/?utm_source=recharge_email&amp;utm_medium=email&amp;utm_campaign=subscription_activation&amp;utm_content=shop" style="text-decoration:none;">
                  <img src="https://cdn.shopify.com/s/files/1/0790/2049/1041/files/Layer_1-2.png" alt="{{ shop_name }}" width="200" height="30" style="display:block;margin:0;max-width:200px !important;width:200px !important;height:auto !important;border:0;">
                </a>
              </td>
            </tr>

            <!-- Intro -->
            <tr>
              <td class="on-content-pad" align="left" style="background-color:#F3EDE1;padding:48px 40px 8px;font-family:'SharpSans-Book', 'Open Sans', Arial, sans-serif !important;line-height:1.4 !important;text-align:left !important;">
                <h1 class="on-heading" style="font-family:'SharpGroteskBold', 'Open Sans', Arial, sans-serif !important;font-weight:700 !important;color:#960000 !important;text-align:left !important;margin:0 0 20px;font-size:32px;line-height:1.4 !important;padding:0;">You Started A New Subscription!</h1>
                <p class="on-body" style="font-family:'SharpSans-Book', 'Open Sans', Arial, sans-serif !important;color:#960000 !important;text-align:left !important;line-height:1.4 !important;font-size:15px;margin:0 0 16px;padding:0;">Hi {{ name }},</p>
                <p class="on-body" style="font-family:'SharpSans-Book', 'Open Sans', Arial, sans-serif !important;color:#960000 !important;text-align:left !important;line-height:1.4 !important;font-size:15px;margin:0 0 28px;padding:0;">Thank you for subscribing. Your first order is locked in, and the good stuff will keep showing up — no extra errands required.</p>
                <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin:0 0 8px;">
                  <tr>
                    <td align="center" style="background-color:#960000 !important;padding:14px 20px;text-align:center;">
                      <a class="manage_subscription_link" href="{{ link }}" target="_blank" rel="noopener noreferrer" title="Manage subscription" style="display:block;width:100%;font-family:'SharpSans-Book', 'Open Sans', Arial, sans-serif !important;color:#ffffff !important;text-decoration:none !important;font-size:13px;font-weight:600;line-height:1.4 !important;"><span style="color:#ffffff !important;">Manage subscription</span></a>
                    </td>
                  </tr>
                </table>
                <p style="font-family:'SharpSans-Book', 'Open Sans', Arial, sans-serif !important;color:#960000 !important;text-align:left !important;line-height:1.4 !important;font-size:15px;margin:24px 0 0;padding:0;">Questions? Email us at <a href="mailto:{{ shop_email }}" style="font-family:'SharpSans-Book', 'Open Sans', Arial, sans-serif !important;color:#960000 !important;font-weight:700;text-decoration:underline !important;"><span style="color:#960000 !important;text-decoration:underline !important;">{{ shop_email }}</span></a>.</p>
              </td>
            </tr>

            <!-- What's next -->
            <tr>
              <td class="on-content-pad" align="left" style="background-color:#F3EDE1;padding:40px 40px 8px;font-family:'SharpSans-Book', 'Open Sans', Arial, sans-serif !important;line-height:1.4 !important;text-align:left !important;">
                <h2 class="on-section-headline" style="font-family:'SharpGroteskBold', 'Open Sans', Arial, sans-serif !important;font-weight:700 !important;color:#960000 !important;text-align:left !important;line-height:1.4 !important;font-size:25px;margin:0 0 16px;padding:0;">What’s next</h2>
                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                  <tr>
                    <td class="on-step" valign="top" width="28" style="width:28px;font-family:'SharpGroteskMedium', 'Open Sans', Arial, sans-serif !important;color:#960000 !important;font-size:15px;line-height:1.4 !important;padding:0 8px 12px 0;">1.</td>
                    <td class="on-step" valign="top" style="font-family:'SharpSans-Book', 'Open Sans', Arial, sans-serif !important;color:#960000 !important;font-size:15px;line-height:1.4 !important;padding:0 0 12px;">We’ll email you when your first order ships.</td>
                  </tr>
                  <tr>
                    <td class="on-step" valign="top" width="28" style="width:28px;font-family:'SharpGroteskMedium', 'Open Sans', Arial, sans-serif !important;color:#960000 !important;font-size:15px;line-height:1.4 !important;padding:0 8px 12px 0;">2.</td>
                    <td class="on-step" valign="top" style="font-family:'SharpSans-Book', 'Open Sans', Arial, sans-serif !important;color:#960000 !important;font-size:15px;line-height:1.4 !important;padding:0 0 12px;">The next box is charged automatically on the schedule below.</td>
                  </tr>
                  <tr>
                    <td class="on-step" valign="top" width="28" style="width:28px;font-family:'SharpGroteskMedium', 'Open Sans', Arial, sans-serif !important;color:#960000 !important;font-size:15px;line-height:1.4 !important;padding:0 8px 0 0;">3.</td>
                    <td class="on-step" valign="top" style="font-family:'SharpSans-Book', 'Open Sans', Arial, sans-serif !important;color:#960000 !important;font-size:15px;line-height:1.4 !important;padding:0;">Skip, swap, or cancel anytime from Manage subscription.</td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Subscription details -->
            <tr>
              <td class="on-content-pad" style="background-color:#F3EDE1;padding:40px 40px 8px;font-family:'SharpSans-Book', 'Open Sans', Arial, sans-serif !important;line-height:1.4 !important;text-align:left !important;">
                <h2 class="on-section-headline" style="font-family:'SharpGroteskBold', 'Open Sans', Arial, sans-serif !important;font-weight:700 !important;color:#960000 !important;text-align:left !important;line-height:1.4 !important;font-size:25px;margin:0 0 16px;padding:0;">Your subscription</h2>
{% for item in line_items %}
                {% if loop.first or item.charge_interval_frequency != line_items[loop.index0 - 1].charge_interval_frequency or item.order_interval_unit != line_items[loop.index0 - 1].order_interval_unit %}
                <p class="on-cadence" style="font-family:'SharpGroteskMedium', 'Open Sans', Arial, sans-serif !important;font-weight:500 !important;color:#960000 !important;text-align:left !important;font-size:13px;letter-spacing:0.12em;text-transform:uppercase;line-height:1.4 !important;margin:{% if loop.first %}0 0 16px{% else %}24px 0 16px{% endif %};padding:0;">
                  {% if item.charge_interval_frequency | int > 1 %}
                    EVERY {{ item.charge_interval_frequency }} {{ item.order_interval_unit | upper }}S
                  {% elif item.charge_interval_frequency | int == 1 %}
                    EVERY {{ item.order_interval_unit | upper }}
                  {% else %}
                    ONE-TIME
                  {% endif %}
                </p>
                {% endif %}
                <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin:0 0 16px;">
                  <tr>
                    <td valign="top" width="76" style="width:76px;padding:0 12px 0 0;">
                      {% if item.images.src %}
                        <img src="{{ item.images.src }}" alt="{{ item.product_title }}" width="72" height="72" style="display:block;width:72px;height:72px;border:0;border-radius:4px;">
                      {% elif "Double the Stop" in item.product_title %}
                        <img src="https://cdn.shopify.com/s/files/1/0790/2049/1041/files/doubleitch.jpg?v=1718576884&amp;width=144" alt="{{ item.product_title }}" width="72" height="72" style="display:block;width:72px;height:72px;border:0;border-radius:4px;">
                      {% elif "Double the Calm" in item.product_title %}
                        <img src="https://cdn.shopify.com/s/files/1/0790/2049/1041/files/doublecalm.jpg?v=1718576884&amp;width=144" alt="{{ item.product_title }}" width="72" height="72" style="display:block;width:72px;height:72px;border:0;border-radius:4px;">
                      {% elif "Shiny Effing" in item.product_title %}
                        <img src="https://cdn.shopify.com/s/files/1/0790/2049/1041/files/1_d5d7e3b1-d2ce-4b09-80c1-be0381482a0d.jpg?v=1781117960&amp;width=144" alt="{{ item.product_title }}" width="72" height="72" style="display:block;width:72px;height:72px;border:0;border-radius:4px;">
                      {% elif "Cat Probiotic" in item.product_title %}
                        <img src="https://cdn.shopify.com/s/files/1/0790/2049/1041/files/Best_Lickables_for_Cat_Gut_health.jpg?v=1781807384&amp;width=144" alt="{{ item.product_title }}" width="72" height="72" style="display:block;width:72px;height:72px;border:0;border-radius:4px;">
                      {% elif "Cat Supplement" in item.product_title %}
                        <img src="https://cdn.shopify.com/s/files/1/0790/2049/1041/files/Best_Daily_Lickable_For_Cats_Oh_Norman_Calming_Lickabl.jpg?v=1781731545&amp;width=144" alt="{{ item.product_title }}" width="72" height="72" style="display:block;width:72px;height:72px;border:0;border-radius:4px;">
                      {% elif "Breath Effing" in item.product_title %}
                        <img src="https://cdn.shopify.com/s/files/1/0790/2049/1041/files/Oh_Norman_dog_dental_wipes_natural_teeth_cleaning_for_dogs.png?v=1777478748&amp;width=144" alt="{{ item.product_title }}" width="72" height="72" style="display:block;width:72px;height:72px;border:0;border-radius:4px;">
                      {% elif "Stop Effing Itching" in item.product_title %}
                        <img src="https://cdn.shopify.com/s/files/1/0790/2049/1041/files/Stop_Effing_Itching_Healthy_Skin_and_Coat_Supplement.png?v=1777493278&amp;width=144" alt="{{ item.product_title }}" width="72" height="72" style="display:block;width:72px;height:72px;border:0;border-radius:4px;">
                      {% elif "Good Effing Gut" in item.product_title %}
                        <img src="https://cdn.shopify.com/s/files/1/0790/2049/1041/files/Pre_Post_Probiotic_Chews_for_Dogs.png?v=1777481512&amp;width=144" alt="{{ item.product_title }}" width="72" height="72" style="display:block;width:72px;height:72px;border:0;border-radius:4px;">
                      {% elif "Calm the Eff Down" in item.product_title %}
                        <img src="https://cdn.shopify.com/s/files/1/0790/2049/1041/files/JanuaryHeroes_38.png?v=1767634743&amp;width=144" alt="{{ item.product_title }}" width="72" height="72" style="display:block;width:72px;height:72px;border:0;border-radius:4px;">
                      {% elif "Calm The Eff Down" in item.product_title %}
                        <img src="https://cdn.shopify.com/s/files/1/0790/2049/1041/files/JanuaryHeroes_38.png?v=1767634743&amp;width=144" alt="{{ item.product_title }}" width="72" height="72" style="display:block;width:72px;height:72px;border:0;border-radius:4px;">
                      {% elif "Clean Effing Ears" in item.product_title %}
                        <img src="https://cdn.shopify.com/s/files/1/0790/2049/1041/files/Ear_Wipes_for_Dogs.png?v=1777479715&amp;width=144" alt="{{ item.product_title }}" width="72" height="72" style="display:block;width:72px;height:72px;border:0;border-radius:4px;">
                      {% elif "Paw Wipes" in item.product_title %}
                        <img src="https://cdn.shopify.com/s/files/1/0790/2049/1041/files/paw_wipes.png?v=1783684960&amp;width=144" alt="{{ item.product_title }}" width="72" height="72" style="display:block;width:72px;height:72px;border:0;border-radius:4px;">
                      {% elif "Body Wipes" in item.product_title %}
                        <img src="https://cdn.shopify.com/s/files/1/0790/2049/1041/files/Natural_body_Wipes.png?v=1783684911&amp;width=144" alt="{{ item.product_title }}" width="72" height="72" style="display:block;width:72px;height:72px;border:0;border-radius:4px;">
                      {% elif "Minty Fresh" in item.product_title %}
                        <img src="https://cdn.shopify.com/s/files/1/0790/2049/1041/files/Minty_Fresh_AF_Breath_Mint.png?v=1777469457&amp;width=144" alt="{{ item.product_title }}" width="72" height="72" style="display:block;width:72px;height:72px;border:0;border-radius:4px;">
                      {% elif "Fresh" in item.product_title %}
                        <img src="https://cdn.shopify.com/s/files/1/0790/2049/1041/files/Dry_Shampoo_for_dogs_-_best_smelling.png?v=1777482486&amp;width=144" alt="{{ item.product_title }}" width="72" height="72" style="display:block;width:72px;height:72px;border:0;border-radius:4px;">
                      {% elif "Clean AF" in item.product_title %}
                        <img src="https://cdn.shopify.com/s/files/1/0790/2049/1041/files/2_f15e9d52-62a3-470b-b78c-09a43ad8bec7.png?v=1767873146&amp;width=144" alt="{{ item.product_title }}" width="72" height="72" style="display:block;width:72px;height:72px;border:0;border-radius:4px;">
                      {% elif "Salmon" in item.product_title %}
                        <img src="https://cdn.shopify.com/s/files/1/0790/2049/1041/files/1_222283b8-0fdc-4ded-9605-33d0e0ceb1ef.png?v=1781119096&amp;width=144" alt="{{ item.product_title }}" width="72" height="72" style="display:block;width:72px;height:72px;border:0;border-radius:4px;">
                      {% elif "Beef Jerky" in item.product_title %}
                        <img src="https://cdn.shopify.com/s/files/1/0790/2049/1041/files/Beef_Treats_-_On_Norman.png?v=1777559164&amp;width=144" alt="{{ item.product_title }}" width="72" height="72" style="display:block;width:72px;height:72px;border:0;border-radius:4px;">
                      {% elif "Pumpkin" in item.product_title %}
                        <img src="https://cdn.shopify.com/s/files/1/0790/2049/1041/files/2_ingredient_packaging_new.jpg?v=1776865879&amp;width=144" alt="{{ item.product_title }}" width="72" height="72" style="display:block;width:72px;height:72px;border:0;border-radius:4px;">
                      {% elif "Training Treats" in item.product_title %}
                        <img src="https://cdn.shopify.com/s/files/1/0790/2049/1041/files/Limited_Ingredient_Treats_-_Pork.png?v=1777480301&amp;width=144" alt="{{ item.product_title }}" width="72" height="72" style="display:block;width:72px;height:72px;border:0;border-radius:4px;">
                      {% endif %}
                    </td>
                    <td valign="top" style="font-family:'SharpSans-Book', 'Open Sans', Arial, sans-serif !important;color:#960000 !important;font-size:14px;line-height:1.4 !important;padding:0 8px 0 0;text-align:left !important;">
                      <strong style="font-family:'SharpGroteskMedium', 'Open Sans', Arial, sans-serif !important;color:#960000 !important;font-size:15px;font-weight:500 !important;line-height:1.4 !important;">{{ item.product_title }}</strong>
                      {% if item.variant_title %}
                        {% if item.variant_title != "Default Title" %}
                          <br><span style="font-family:'SharpSans-Book', 'Open Sans', Arial, sans-serif !important;color:#960000 !important;">{{ item.variant_title }}</span>
                        {% endif %}
                      {% endif %}
                      <div style="margin:8px 0 0;font-family:'SharpSans-Book', 'Open Sans', Arial, sans-serif !important;color:#960000 !important;font-size:14px;line-height:1.4 !important;">
                        {% if item.quantity %}
                          <div>&middot;&nbsp;Qty {{ item.quantity }} &times; {{ item.price | amount_with_currency(charge_currency, display_currency_code=False) }}</div>
                        {% endif %}
                        {% if item.number_charges_until_expiration %}
                          <div style="margin:4px 0 0;">Expires after {{ item.number_charges_until_expiration }}
                          {% if item.number_charges_until_expiration | int == 1 %}charge{% else %}charges{% endif %}</div>
                        {% endif %}
                      </div>
                    </td>
                    <td valign="top" align="right" style="font-family:'SharpSans-Book', 'Open Sans', Arial, sans-serif !important;color:#960000 !important;font-size:14px;line-height:1.4 !important;text-align:right;white-space:nowrap;padding-left:8px;">
                      {% if item.quantity %}
                        {{ (item.price * item.quantity) | amount_with_currency(charge_currency, display_currency_code=False) }}
                      {% else %}
                        {{ item.price | amount_with_currency(charge_currency, display_currency_code=False) }}
                      {% endif %}
                    </td>
                  </tr>
                </table>
{% endfor %}

{% if discount_code %}
                <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin:8px 0 16px;">
                  <tr>
                    <td style="font-family:'SharpSans-Book', 'Open Sans', Arial, sans-serif !important;color:#960000 !important;font-size:14px;line-height:1.4 !important;padding:8px 0;">{{ discount_code }}</td>
                    <td align="right" style="font-family:'SharpSans-Book', 'Open Sans', Arial, sans-serif !important;color:#960000 !important;font-size:14px;line-height:1.4 !important;text-align:right;padding:8px 0;">-{{ total_discounts | amount_with_currency(charge_currency, display_currency_code=False) }}</td>
                  </tr>
                </table>
{% endif %}

                <table border="0" cellpadding="0" cellspacing="0" width="100%">
